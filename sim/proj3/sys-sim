sim_dir = os.path.dirname( os.path.abspath( __file__ ) )
while sim_dir:
  if os.path.exists( sim_dir + os.path.sep + "pymtl.ini" ):
    sys.path.insert(0,sim_dir)
    break
  sim_dir = os.path.dirname(sim_dir)

import argparse

from random import seed
seed(0xdeadbeef)

from pymtl3 import *
from pymtl3.stdlib.test_utils import config_model_with_cmdline_opts
from pymtl3.passes.backends.verilog import *

from proj3.OoO_SingleCoreSysFL import OoO_SingleCoreSysFL
from proj3.OoO_SingleCoreSys   import OoO_SingleCoreSys
from proj3.Base_SingleCoreSys  import Base_SingleCoreSys

# IMPORTANT:
# Reuse the exact system-level harness used by your pytest system tests.
# This avoids mismatches in mngr2proc/proc2mngr/memory/done handling.

from proj3.test.harness_sys import SingleCoreTestHarness

from proj3.ubmark.sys_ubmark_vvadd_unopt import sys_ubmark_vvadd_unopt
from proj3.ubmark.sys_ubmark_vvadd_opt   import sys_ubmark_vvadd_opt
from proj3.ubmark.sys_ubmark_cmult       import sys_ubmark_cmult

from proj3.ubmark.sys_ubmark_vmuladd2_unopt         import sys_ubmark_vmuladd2_unopt
from proj3.ubmark.sys_ubmark_chacha20_unrolled      import sys_ubmark_chacha20_unrolled
from proj3.ubmark.sys_ubmark_dotprod_unopt_unrolled import sys_ubmark_dotprod_unopt_unrolled
from proj3.ubmark.sys_ubmark_vvadd_sw_opt           import sys_ubmark_vvadd_sw_opt

#-------------------------------------------------------------------------
# Command line processing
#-------------------------------------------------------------------------

class ArgumentParserWithCustomError(argparse.ArgumentParser):

  def error( self, msg = "" ):
    if ( msg ):
      print("\n ERROR: %s" % msg)
    print("")
    file = open( sys.argv[0] )
    for ( lineno, line ) in enumerate( file ):
      if ( line[0] != '#' ):
        sys.exit(msg != "")
      if ( (lineno == 2) or (lineno >= 4) ):
        print( line[1:].rstrip("\n") )

def parse_cmdline():

  p = ArgumentParserWithCustomError( add_help=False )

  p.add_argument( "-h", "--help", action="store_true" )

  # Keep several aliases so your existing commands still work.

  p.add_argument( "--impl", default="OoO",
    choices=["fl", "score-fl", "OoO", "ooo", "base"] )

  p.add_argument( "--input", default="vvadd-unopt",
    choices=["vvadd-unopt", "vvadd-opt", "cmult",
             "vmuladd2-unopt", "chacha20-unrolled",
             "dotprod-unopt-unrolled", "vvadd-sw-opt"] )

  p.add_argument( "--trace",                     action="store_true" )
  p.add_argument( "--stats",                     action="store_true" )
  p.add_argument( "--verify",                    action="store_true" )
  p.add_argument( "--dump-vcd",                  action="store_true" )
  p.add_argument( "--translate",                 action="store_true" )
  p.add_argument( "--dump-vtb",                  action="store_true" )
  p.add_argument( "--short-mname",               action="store_true" )
  p.add_argument( "--mem-delays",                action="store_true" )
  p.add_argument( "--max-cycles", default=50000, type=int )

  opts = p.parse_args()

  if opts.help:
    p.error()

  return opts

#-------------------------------------------------------------------------
# Helper functions
#-------------------------------------------------------------------------

def get_commit_inst( th ):

  if hasattr( th, "commit_inst" ):
    return th.commit_inst

  if hasattr( th, "sys" ) and hasattr( th.sys, "commit_inst" ):
    return th.sys.commit_inst

  return 0

def get_icache_access( th ):

  if hasattr( th, "icache_access" ):
    return th.icache_access

  if hasattr( th, "sys" ) and hasattr( th.sys, "icache_access" ):
    return th.sys.icache_access

  return 0

def get_icache_miss( th ):

  if hasattr( th, "icache_miss" ):
    return th.icache_miss

  if hasattr( th, "sys" ) and hasattr( th.sys, "icache_miss" ):
    return th.sys.icache_miss

  return 0

def get_dcache_access( th ):

  if hasattr( th, "dcache_access" ):
    return th.dcache_access

  if hasattr( th, "sys" ) and hasattr( th.sys, "dcache_access" ):
    return th.sys.dcache_access

  return 0

def get_dcache_miss( th ):

  if hasattr( th, "dcache_miss" ):
    return th.dcache_miss

  if hasattr( th, "sys" ) and hasattr( th.sys, "dcache_miss" ):
    return th.sys.dcache_miss

  return 0

def get_memory( th ):

  # This matches the common ECE6745/ECE4750 MemoryFL hierarchy.

  if hasattr( th, "mem" ) and hasattr( th.mem, "mem" ) and hasattr( th.mem.mem, "mem" ):
    return th.mem.mem.mem

  if hasattr( th, "mem" ) and hasattr( th.mem, "mem" ):
    return th.mem.mem

  if hasattr( th, "mem" ):
    return th.mem

  raise AttributeError( "Cannot find backing memory in SingleCoreTestHarness." )

def get_done_debug_str( th ):

  fields = []

  if hasattr( th, "src" ):
    try:
      fields.append( "src_done={}".format( th.src.done() ) )
    except:
      pass

  if hasattr( th, "sink" ):
    try:
      fields.append( "sink_done={}".format( th.sink.done() ) )
    except:
      pass

  if hasattr( th, "srcs" ):
    try:
      fields.append( "srcs_done={}".format( [ x.done() for x in th.srcs ] ) )
    except:
      pass

  if hasattr( th, "sinks" ):
    try:
      fields.append( "sinks_done={}".format( [ x.done() for x in th.sinks ] ) )
    except:
      pass

  if not fields:
    fields.append( "no source/sink debug fields found" )

  return ", ".join( fields )

#-------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------

def main():

  opts = parse_cmdline()

  # Select system model

  model_impl_dict = {
    "fl"       : OoO_SingleCoreSysFL,
    "score-fl" : OoO_SingleCoreSysFL,

    # OoO RTL system (5-stage pipeline + Rename + ROB + IQ).
    "OoO"      : OoO_SingleCoreSys,
    "ooo"      : OoO_SingleCoreSys,

    # Baseline RTL system (5-stage in-order pipeline with full bypass).
    "base"     : Base_SingleCoreSys,   # ← 之前是 OoO_SingleCoreSys
  }

  if opts.translate and opts.impl in ["fl", "score-fl"]:
    print("\n ERROR: --translate only works with RTL models \n")
    exit(1)

  # Use the same harness as system pytest

  th = SingleCoreTestHarness( model_impl_dict[ opts.impl ] )

  # Optional backing memory delay

  if opts.mem_delays:
    th.set_param( "top.mem.construct", stall_prob=0.5 )
    th.set_param( "top.mem.construct", extra_latency=3 )

  # VCD/VTB names

  unique_name = f"sys-{opts.impl}-{opts.input}"

  if opts.short_mname:
    vtb_name = f"{opts.input}"
  else:
    vtb_name = unique_name

  cmdline_opts = {
    'dump_vcd'    : f"{unique_name}" if opts.dump_vcd else '',
    'dump_vtb'    : f"{vtb_name}"    if opts.dump_vtb else '',
    'test_verilog': 'zeros'          if opts.translate else '',
  }

  # Configure model

  th.elaborate()

  config_model_with_cmdline_opts( th, cmdline_opts, duts=['sys'] )

  th.apply( DefaultPassGroup( linetrace=opts.trace ) )

  # Select benchmark

  input_dict = {
    "vvadd-unopt"            : sys_ubmark_vvadd_unopt,
    "vvadd-opt"              : sys_ubmark_vvadd_opt,
    "cmult"                  : sys_ubmark_cmult,

    "vmuladd2-unopt"         : sys_ubmark_vmuladd2_unopt,
    "chacha20-unrolled"      : sys_ubmark_chacha20_unrolled,
    "dotprod-unopt-unrolled" : sys_ubmark_dotprod_unopt_unrolled,
    "vvadd-sw-opt"           : sys_ubmark_vvadd_sw_opt,
  }

  input = input_dict[ opts.input ]

  # Generate and load memory image

  mem_image = input.gen_mem_image()
  th.load( mem_image )

  # Reset

  print()
  th.sim_reset()

  # Run simulation

  num_cycles        = 0
  num_insts         = 0
  num_icache_access = 0
  num_icache_miss   = 0
  num_dcache_access = 0
  num_dcache_miss   = 0

  while not th.done() and th.sim_cycle_count() < opts.max_cycles:

    th.sim_tick()

    num_cycles += 1

    if get_commit_inst( th ):
      num_insts += 1

    if get_icache_access( th ):
      num_icache_access += 1

    if get_icache_miss( th ):
      num_icache_miss += 1

    if get_dcache_access( th ):
      num_dcache_access += 1

    if get_dcache_miss( th ):
      num_dcache_miss += 1

  # Timeout

  if th.sim_cycle_count() >= opts.max_cycles:

    print()
    print( " TIMEOUT DEBUG" )
    print( " done_debug        = {}".format( get_done_debug_str( th ) ) )
    print( " num_cycles        = {}".format( num_cycles ) )
    print( " num_insts         = {}".format( num_insts ) )
    print( " num_icache_access = {}".format( num_icache_access ) )
    print( " num_icache_miss   = {}".format( num_icache_miss ) )
    print( " num_dcache_access = {}".format( num_dcache_access ) )
    print( " num_dcache_miss   = {}".format( num_dcache_miss ) )
    print()

    print(f"""
   ERROR: Exceeded maximum number of cycles ({opts.max_cycles}).
   Your program might be stuck, or you may need to increase --max-cycles.
    """)
    exit(1)

  # Extra ticks to make VCD easier to read

  th.sim_tick()
  th.sim_tick()
  th.sim_tick()

  # Verify

  if opts.verify:
    passed = input.verify( get_memory( th ) )
    print()
    if not passed:
      exit(1)

  # Stats

  if opts.stats:

    cpi = 0.0
    if num_insts > 0:
      cpi = float(num_cycles) / float(num_insts)

    icache_miss_rate = 0.0
    if num_icache_access > 0:
      icache_miss_rate = float(num_icache_miss) / float(num_icache_access)

    dcache_miss_rate = 0.0
    if num_dcache_access > 0:
      dcache_miss_rate = float(num_dcache_miss) / float(num_dcache_access)

    print( " num_cycles        = {}".format( num_cycles ) )
    print( " num_insts         = {}".format( num_insts ) )
    print( " CPI               = {:1.2f}".format( cpi ) )
    print()
    print( " num_icache_access = {}".format( num_icache_access ) )
    print( " num_icache_miss   = {}".format( num_icache_miss ) )
    print( " icache_miss_rate  = {:1.2f}".format( icache_miss_rate ) )
    print()
    print( " num_dcache_access = {}".format( num_dcache_access ) )
    print( " num_dcache_miss   = {}".format( num_dcache_miss ) )
    print( " dcache_miss_rate  = {:1.2f}".format( dcache_miss_rate ) )
    print()

main()