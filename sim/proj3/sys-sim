#
#  -h --help           Display this message
#
#  --impl              {fl,OoO,ooo,base}
#  --input dataset     {vvadd-unopt,vvadd-opt,cmult,
#                       vmuladd2-unopt,chacha20-unrolled,
#                       dotprod-unopt-unrolled,vvadd-sw-opt}
#  --verify            Verify results
#  --trace             Display line tracing
#  --stats             Display statistics
#  --translate         Translate/import RTL model to Verilog
#  --dump-vcd          Dump VCD to sys-<impl>-<input>.vcd
#  --dump-vtb          Dump Verilog test bench
#  --short-mname       Use short module/testbench name
#  --max-cycles        Set timeout num_cycles, default=15000
#  --mem-delays        Turn on backing memory delays
#
# System-level simulator for OoO processor + icache + dcache.
#

